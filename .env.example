DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_coach?schema=public"
# Used only by `prisma migrate deploy` / `prisma migrate dev`. With a pooled
# provider (e.g. Neon) this should be the *unpooled* connection string; for a
# plain local/self-hosted Postgres it's identical to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fitness_coach?schema=public"
AUTH_SECRET="replace-with-a-long-random-string-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STORAGE_DIR="./storage"

# --- Social login (all optional — each provider's button only appears once ---
# --- its two variables below are set; leave unset to keep password-only). ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/oauth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra admin center → App registrations.
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/oauth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional: restrict sign-in to a single Microsoft 365 tenant instead of any
# Microsoft account. Leave unset for "common" (personal + any work/school account).
MICROSOFT_TENANT_ID=""

# Apple Developer account (paid) → Certificates, Identifiers & Profiles.
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/oauth/callback/apple
# APPLE_CLIENT_SECRET is a JWT you generate yourself (see OAUTH_SETUP.md),
# not a plain string, and needs regenerating before it expires (max 6 months).
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
